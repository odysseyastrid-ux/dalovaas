# Copy to .env and fill in for your environment.

DATABASE_URL=postgres://magicstick:magicstick_dev_pw@localhost:5432/magicstick_clean
JWT_SECRET=change-this-to-a-long-random-string
PORT=3001

# Comma-separated list of origins allowed to call this API from a browser
# (your deployed site + local dev). Leave unset only for local development —
# it then falls back to allowing http://localhost:* origins.
ALLOWED_ORIGINS=https://magicstickclean.ca

# Set to "true" only if this server actually runs behind a reverse proxy or
# load balancer that sets X-Forwarded-For itself (Render, Railway, nginx,
# Cloudflare, ...). Leave unset/false for a direct/bare deployment — trusting
# that header without a real proxy in front lets a client spoof its own IP
# and dodge the rate limiter.
TRUST_PROXY=false

# Used only by `npm run seed`, to create the first admin login.
ADMIN_EMAIL=owner@magicstickclean.com
ADMIN_PASSWORD=change-this-before-seeding
