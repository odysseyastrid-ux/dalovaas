# Copy to .env in this same folder and fill in before `docker compose up -d`.

# Set this to the real, public URL you'll reach Twenty at (with https once
# you put a reverse proxy + TLS in front of it). Must match exactly what
# visitors/you type in a browser — no trailing slash.
SERVER_URL=https://crm.yourdomain.com

# Generate one strong random secret and use it as ENCRYPTION_KEY:
#   openssl rand -base64 32
# Keep it saved somewhere safe — losing it locks you out of encrypted data.
ENCRYPTION_KEY=replace_me_with_a_random_string

# Change from the default before your first `docker compose up -d`.
PG_DATABASE_PASSWORD=replace_me_with_a_strong_password_without_special_characters

STORAGE_TYPE=local
